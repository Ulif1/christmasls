# Copy to .env and export the values before starting the server:
#   cp .env.example .env
#   set -a; source .env; set +a
# The server does not load .env files on its own.

# PostgreSQL connection string. The defaults below match the compose service.
DATABASE_URL=postgresql://user:password@localhost:5432/christmasdb

# Signing secret for auth tokens. Change this outside local development.
JWT_SECRET=dev-only-change-me

# API port.
PORT=3001

# Base URL used by server/scripts/smoke.ts.
BASE_URL=http://localhost:3001
